{
  "name": "sovereign-local-core",
  "version": "0.3.0",
  "description": "A sovereign local-first browser database engine with C++/WASM queries, encrypted OPFS, signed read/write policies and WebRTC sync.",
  "license": "MIT",
  "author": "Sovereign Local Core contributors",
  "keywords": [
    "local-first",
    "offline-first",
    "crdt",
    "p2p",
    "wasm",
    "webassembly",
    "database",
    "opfs",
    "webrtc",
    "e2ee",
    "event-sourcing",
    "react",
    "wallet",
    "row-level-security",
    "invariants",
    "indexing",
    "web-crypto"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5645hm-a11y/sovereign-local-core.git"
  },
  "homepage": "https://github.com/5645hm-a11y/sovereign-local-core#readme",
  "bugs": {
    "url": "https://github.com/5645hm-a11y/sovereign-local-core/issues"
  },
  "type": "module",
  "main": "./package-dist/index.js",
  "module": "./package-dist/index.js",
  "types": "./package-dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./package-dist/types/index.d.ts",
      "import": "./package-dist/index.js"
    },
    "./react": {
      "types": "./package-dist/types/react.d.ts",
      "import": "./package-dist/react.js"
    },
    "./worker": "./package-dist/worker.js",
    "./package.json": "./package.json",
    "./nostr": {
      "types": "./package-dist/types/nostr-discovery.d.ts",
      "import": "./package-dist/nostr.js"
    }
  },
  "files": [
    "package-dist",
    "scripts/copy-assets.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "p2p-core-copy-assets": "scripts/copy-assets.mjs"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run build:wasm && npm run build:ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ts": "tsc -p tsconfig.json && node scripts/build-discovery.mjs",
    "build:package": "npm run build:ts && node scripts/build-wasm.mjs --browser && node scripts/build-package.mjs",
    "prepack": "npm run build:package",
    "demo:react": "npm run dev --prefix examples/react-demo",
    "demo:react:build": "npm run build --prefix examples/react-demo",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:invariants": "npm run build && node scripts/benchmark-invariants.mjs",
    "benchmark:fields": "npm run build && node scripts/benchmark-field-queries.mjs",
    "benchmark:queries": "npm run build && node scripts/benchmark-queries.mjs",
    "benchmark:queries:browser": "npm run build && node scripts/benchmark-queries-browser.mjs",
    "benchmark:sync": "npm run build && node scripts/benchmark-sync-cursor.mjs",
    "benchmark:discovery": "npm run build:ts && node scripts/benchmark-discovery-routing.mjs",
    "benchmark:epochs": "npm run build:ts && node scripts/benchmark-epoch-pages.mjs",
    "benchmark:recovery": "npm run build:ts && node scripts/benchmark-recovery-routing.mjs",
    "benchmark:browser": "npm run build && node scripts/benchmark-browser.mjs",
    "dev": "npm run demo:react",
    "demo:prepare": "node scripts/prepare-examples.mjs",
    "demo:vanilla": "npm run dev --prefix examples/vanilla-todo",
    "dev:fixtures": "npm run build && node scripts/serve-fixtures.mjs",
    "check:release": "node scripts/check-release.mjs",
    "signaling": "node scripts/signaling-server.mjs",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:dx": "node scripts/test-dx.mjs"
  },
  "devDependencies": {
    "@noble/secp256k1": "3.2.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  }
}
