{
  "name": "sovereign-local-core",
  "version": "0.1.0",
  "description": "A local-first P2P database for the web: C++/WASM CRDTs, encrypted OPFS, WebRTC sync and streamed file storage.",
  "license": "MIT",
  "author": "Sovereign Local Core contributors",
  "keywords": ["local-first", "offline-first", "crdt", "p2p", "wasm", "webassembly", "database", "opfs", "webrtc", "e2ee", "event-sourcing", "react"],
  "repository": { "type": "git", "url": "git+https://github.com/5645hm-a11y/sovereign-local-core.git" },
  "homepage": "https://github.com/5645hm-a11y/sovereign-local-core#readme",
  "bugs": { "url": "https://github.com/5645hm-a11y/sovereign-local-core/issues" },
  "type": "module",
  "main": "./package-dist/index.js",
  "module": "./package-dist/index.js",
  "types": "./package-dist/types/index.d.ts",
  "exports": {
    ".": { "types": "./package-dist/types/index.d.ts", "import": "./package-dist/index.js" },
    "./react": { "types": "./package-dist/types/react.d.ts", "import": "./package-dist/react.js" },
    "./worker": "./package-dist/worker.js",
    "./package.json": "./package.json"
  },
  "files": ["package-dist", "scripts/copy-assets.mjs", "README.md", "LICENSE", "docs"],
  "bin": { "p2p-core-copy-assets": "scripts/copy-assets.mjs" },
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "peerDependencies": { "react": ">=18 <20" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "scripts": {
    "build": "npm run build:wasm && npm run build:ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build:package": "npm run build:ts && node scripts/build-wasm.mjs --browser && node scripts/build-package.mjs",
    "prepack": "npm run build:package",
    "demo:react": "npm run dev --prefix examples/react-demo",
    "demo:react:build": "npm run build --prefix examples/react-demo",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:browser": "npm run build && node scripts/benchmark-browser.mjs",
    "dev": "npm run demo:react",
    "demo:prepare": "node scripts/prepare-examples.mjs",
    "demo:vanilla": "npm run dev --prefix examples/vanilla-todo",
    "dev:fixtures": "npm run build && node scripts/serve-fixtures.mjs",
    "check:release": "node scripts/check-release.mjs",
    "signaling": "node scripts/signaling-server.mjs",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:dx": "node scripts/test-dx.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  }
}
